# Copy to .env at repository root. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=BT3_Schema1
DB_USER=bt3_app
DB_PASSWORD=replace-with-your-local-mysql-password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
COMPETITION_CODE=demo
# Only add the actual frontend origins when frontend is implemented.
CORS_ORIGINS=[]
